# OpenWrt router defaults plus EW30SX radio staging and the 256 MiB NSS stack.
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq50xx=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_USE_APK=y
CONFIG_SIGNED_PACKAGES=y
CONFIG_DEVEL=y
CONFIG_CCACHE=y
CONFIG_AUTOREMOVE=y
# CONFIG_KERNEL_DEBUG_INFO is not set
# CONFIG_KERNEL_MAGIC_SYSRQ is not set

# Use the 256 MiB NSS profile and 12.2 firmware.
CONFIG_PACKAGE_nss-tools-dwmac=y
CONFIG_PACKAGE_nss-firmware=y
CONFIG_PACKAGE_kmod-qca-nss-drv-pppoe=y
CONFIG_NSS_FIRMWARE_VERSION_12_2=y
CONFIG_NSS_MEM_PROFILE_LOW=y
CONFIG_PACKAGE_MAC80211_NSS_SUPPORT=y
CONFIG_PACKAGE_MAC80211_MESH=y
CONFIG_ATH11K_NSS_SUPPORT=y
CONFIG_NSS_DRV_WIFIOFFLOAD_ENABLE=y
CONFIG_NSS_DRV_WIFI_EXT_VDEV_ENABLE=y
CONFIG_PACKAGE_squashfs-tools-unsquashfs=y
CONFIG_SQUASHFS_TOOLS_XZ_SUPPORT=y
CONFIG_SQUASHFS_TOOLS_XZ_EXTENDED_SUPPORT=y

# Full wpad on both images; the device recipes remove the basic variant.
CONFIG_PACKAGE_wpad-basic-mbedtls=m
CONFIG_PACKAGE_wpad-mbedtls=y

# Optional, matching-ABI packages. EW30SX has no exposed USB port.
CONFIG_PACKAGE_kmod-tun=m
CONFIG_PACKAGE_kmod-wireguard=m
CONFIG_PACKAGE_kmod-fs-vfat=m
CONFIG_PACKAGE_kmod-fs-exfat=m
CONFIG_PACKAGE_kmod-fs-ntfs3=m
CONFIG_PACKAGE_kmod-fs-f2fs=m
CONFIG_PACKAGE_kmod-nls-cp437=m
CONFIG_PACKAGE_kmod-nls-iso8859-1=m
CONFIG_PACKAGE_kmod-nls-utf8=m
CONFIG_PACKAGE_kmod-fs-nfs=m
CONFIG_PACKAGE_kmod-fs-cifs=m
CONFIG_PACKAGE_kmod-gre=m
CONFIG_PACKAGE_kmod-vxlan=m
CONFIG_PACKAGE_kmod-l2tp=m
CONFIG_PACKAGE_kmod-bonding=m
CONFIG_PACKAGE_kmod-nft-queue=m
CONFIG_PACKAGE_kmod-nft-socket=m
CONFIG_PACKAGE_kmod-nft-tproxy=m
CONFIG_PACKAGE_kmod-inet-diag=m
CONFIG_PACKAGE_kmod-netlink-diag=m
