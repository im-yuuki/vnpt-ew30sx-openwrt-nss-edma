CONFIG_TARGET_DEVICE_qualcommax_ipq50xx_DEVICE_vnpt_ew30sx-nor=y
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set
# Router services and diagnostics from the Xiaomi build. Keep them out of RAM recovery.
CONFIG_NSS_DRV_IGS_ENABLE=y
CONFIG_NSS_DRV_SHAPER_ENABLE=y
CONFIG_PACKAGE_bind-dig=y
CONFIG_PACKAGE_dumpimage=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_kmod-qca-nss-drv-igs=y
CONFIG_PACKAGE_kmod-qca-nss-drv-netlink=y
CONFIG_PACKAGE_kmod-qca-nss-drv-qdisc=y
CONFIG_PACKAGE_luci-app-nss=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_nssinfo=y
CONFIG_PACKAGE_sqm-scripts-nss=y
CONFIG_PACKAGE_tc-full=y
CONFIG_PACKAGE_zram-swap=y
