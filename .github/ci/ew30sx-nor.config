CONFIG_TARGET_DEVICE_qualcommax_ipq50xx_DEVICE_vnpt_ew30sx-nor=y
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set
CONFIG_PACKAGE_luci-ssl=y
# Only full wpad has WPS and 802.11s. Do not install both variants.
# The NOR device profile removes the target's basic variant from its rootfs.
CONFIG_PACKAGE_wpad-basic-mbedtls=m
CONFIG_PACKAGE_wpad-mbedtls=y
