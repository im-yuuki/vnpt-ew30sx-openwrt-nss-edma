 	cmcc,rax3000q|\
diff --git a/target/linux/qualcommax/ipq50xx/base-files/lib/functions/ew30sx-wifi.sh b/target/linux/qualcommax/ipq50xx/base-files/lib/functions/ew30sx-wifi.sh
index aa2aae1628..830efcf91d 100644
--- a/target/linux/qualcommax/ipq50xx/base-files/lib/functions/ew30sx-wifi.sh
+++ b/target/linux/qualcommax/ipq50xx/base-files/lib/functions/ew30sx-wifi.sh
@@ -10,7 +10,9 @@ ew30sx_mtd() {
 	[ "$(cat "$dev/offset")" = "$2" ] || return 1
 	[ "$(cat "$dev/size")" = "$3" ] || return 1
 	flags="$(cat "$dev/flags")" || return 1
-	[ $((flags & 0x400)) -eq 0 ] || return 1
+	case "$flags" in 0x*) flags="${flags#0x}" ;; *) return 1 ;; esac
+	case "$flags" in ''|*[!0-9a-fA-F]*) return 1 ;; esac
+	[ "$((0x$flags & 0x400))" -eq 0 ] || return 1
 	echo "$id"
 }
 
@@ -19,40 +21,60 @@ ew30sx_check_blob() {
 		[ "$(tr -d '\000\377' < "$1" | wc -c)" -gt 0 ]
 }
 
-# The stock MP02 script reads raw 128 KiB slices from ART. Stock's BDFs
-# are separate files in the WIFIFW SquashFS. Do not keep a copy of ART,
-# use stock executable firmware, or patch the factory bytes.
+ew30sx_extract_bdf() (
+	# Bound output to 128 KiB (512-byte blocks) and cap total address space
+	# separately from the extractor's decompression caches.
+	ulimit -c 0 && ulimit -f 256 && ulimit -v 98304 || return 1
+	unset PAGER SQFS_CMDLINE
+	exec /usr/sbin/unsquashfs -cat -no-wildcards -strict-errors \
+		-processors 1 -mem 8M "$1" "$2"
+)
+
+# Read WIFIFW directly with userspace XZ support and only the two ART slices.
+# Do not mount or copy partitions, stage stock executables, or patch the bytes.
 ew30sx_stage_wifi() (
-	local art wififw dir fw
+	local art wififw dir fw ipq qcn ipq_cal qcn_cal path
 
 	[ -e /tmp/ew30sx-wifi-ready ] && return 0
 	art="$(ew30sx_mtd 0:ART 1769472 458752)" || return 1
 	wififw="$(ew30sx_mtd 0:WIFIFW 28442624 4194304)" || return 1
-	[ -c "/dev/mtd${art}ro" ] && [ -b "/dev/mtdblock$wififw" ] || return 1
+	art="/dev/mtd${art}ro"
+	wififw="/dev/mtdblock$wififw"
+	[ -c "$art" ] && [ -b "$wififw" ] || return 1
 
 	umask 077
 	dir="$(mktemp -d /tmp/ew30sx-wifi.XXXXXX)" || return 1
-	mkdir "$dir/stock" || { rmdir "$dir"; return 1; }
-	trap 'umount "$dir/stock" 2>/dev/null
-		rm -f "$dir/bdf-2g" "$dir/bdf-5g" "$dir/cal-2g" "$dir/cal-5g"
-		rmdir "$dir/stock" "$dir" 2>/dev/null' EXIT
-	mount -t squashfs -o ro,nodev,nosuid,noexec "/dev/mtdblock$wififw" "$dir/stock" ||
+	trap 'rm -f "$dir/bdf-2g" "$dir/bdf-5g" "$dir/cal-2g" "$dir/cal-5g"
+		rmdir "$dir" 2>/dev/null' EXIT
+
+	ew30sx_extract_bdf "$wififw" bdwlan.b10 >"$dir/bdf-2g" 2>/dev/null &&
+		ew30sx_check_blob "$dir/bdf-2g" &&
+		ew30sx_extract_bdf "$wififw" qcn6122/bdwlan.b60 >"$dir/bdf-5g" 2>/dev/null &&
+		ew30sx_check_blob "$dir/bdf-5g" ||
 		return 1
 
-	cp "$dir/stock/bdwlan.b10" "$dir/bdf-2g" &&
-		cp "$dir/stock/qcn6122/bdwlan.b90" "$dir/bdf-5g" &&
-		dd if="/dev/mtd${art}ro" of="$dir/cal-2g" bs=2048 skip=2 count=64 2>/dev/null &&
-		dd if="/dev/mtd${art}ro" of="$dir/cal-5g" bs=2048 skip=77 count=64 2>/dev/null ||
+	dd if="$art" of="$dir/cal-2g" bs=2048 skip=2 count=64 2>/dev/null &&
+		dd if="$art" of="$dir/cal-5g" bs=2048 skip=77 count=64 2>/dev/null &&
+		ew30sx_check_blob "$dir/cal-2g" &&
+		ew30sx_check_blob "$dir/cal-5g" ||
 		return 1
-	umount "$dir/stock" || return 1
-	for fw in bdf-2g bdf-5g cal-2g cal-5g; do
-		ew30sx_check_blob "$dir/$fw" || return 1
-	done
 
 	fw=/lib/firmware/ath11k
-	cp "$dir/bdf-2g" "$fw/IPQ5018/hw1.0/board.bin" &&
-		cp "$dir/bdf-5g" "$fw/QCN6122/hw1.0/board.bin" &&
-		cp "$dir/cal-2g" "$fw/IPQ5018/hw1.0/cal-ahb-c000000.wifi.bin" &&
-		cp "$dir/cal-5g" "$fw/QCN6122/hw1.0/cal-ahb-b00a040.wifi.bin" &&
-		touch /tmp/ew30sx-wifi-ready
+	ipq="$fw/IPQ5018/hw1.0"
+	qcn="$fw/QCN6122/hw1.0"
+	ipq_cal="$ipq/cal-ahb-c000000.wifi.bin"
+	qcn_cal="$qcn/cal-ahb-b00a040.wifi.bin"
+	for path in "$ipq/board.bin" "$qcn/board.bin" "$ipq_cal" "$qcn_cal"; do
+		[ ! -e "$path" ] && [ ! -L "$path" ] || return 1
+	done
+
+	if cp "$dir/bdf-2g" "$ipq/board.bin" &&
+		cp "$dir/bdf-5g" "$qcn/board.bin" &&
+		cp "$dir/cal-2g" "$ipq_cal" &&
+		cp "$dir/cal-5g" "$qcn_cal" &&
+		touch /tmp/ew30sx-wifi-ready; then
+		return 0
+	fi
+	rm -f "$ipq/board.bin" "$qcn/board.bin" "$ipq_cal" "$qcn_cal" /tmp/ew30sx-wifi-ready
+	return 1
 )
