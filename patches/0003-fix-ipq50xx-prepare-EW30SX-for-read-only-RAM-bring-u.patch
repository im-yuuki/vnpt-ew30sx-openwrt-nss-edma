diff --git a/package/nss/nss-tools/files/nss-dwmac-up b/package/nss/nss-tools/files/nss-dwmac-up
index d8f1fe7300..271281b503 100644
--- a/package/nss/nss-tools/files/nss-dwmac-up
+++ b/package/nss/nss-tools/files/nss-dwmac-up
@@ -4,6 +4,7 @@
 # netifd ran; this instance starts alongside netifd, waits for the VLAN
 # topology it builds on the trunk, and brings up connection acceleration.
 set -e
+. /lib/functions.sh
 . /lib/nss/functions.sh
 
 [ "$(readlink /sbin/modprobe)" = /sbin/kmodloader ] ||
@@ -20,6 +21,14 @@ FWM=/sys/kernel/debug/qca-dwmac-nss/fw_mask
 # before the arm and before ath11k - a board with no radios (measured, E287).
 TOPOLOGY="$(uci -q get nss.general.topology)" || TOPOLOGY=''
 TRUNK="$(uci -q get nss.general.trunk)" || TRUNK=''
+EW30SX=0
+ARM=1
+if [ "$(board_name)" = "vnpt,ew30sx" ]; then
+  EW30SX=1
+  TOPOLOGY=''
+  TRUNK="$(nss_gmac_netdevs | sed -n 's/^0://p')"
+  [ -n "$TRUNK" ] || exit 1
+fi
 # C-3PO: the trunk is the DSA conduit, and the board says which netdev
 # that is (nss.general.trunk overrides).
 if [ -z "$TRUNK" ] && [ "$TOPOLOGY" = "dsa" ]; then
@@ -43,12 +52,21 @@ fi
 eth_up() {
   [ "$(cat /sys/class/net/$TRUNK/operstate 2>/dev/null)" = "up" ]
 }
-poll_until 30 eth_up || echo "WARN: $TRUNK not up after 30s, arming anyway"
+arm_timeout() {
+  if [ "$EW30SX" = 1 ]; then
+    echo "EW30SX: $1; leaving GMAC0 on the host path"
+    ARM=0
+  else
+    echo "WARN: $1, arming anyway"
+  fi
+}
+
+poll_until 30 eth_up || arm_timeout "$TRUNK not up after 30s"
 
 lan_up() {
   ubus call network.interface.lan status 2>/dev/null | grep -q '"up": true'
 }
-poll_until 30 lan_up || echo "WARN: netifd lan not up after 30s, arming anyway"
+[ "$ARM" = 0 ] || poll_until 30 lan_up || arm_timeout "netifd lan not up after 30s"
 
 eth_promisc() {
   [ $(( $(cat /sys/class/net/$TRUNK/flags 2>/dev/null || echo 0) & 0x100 )) -ne 0 ]
@@ -58,15 +76,17 @@ eth_promisc() {
 # the conduit's hardware VLAN filter and the user ports add their MACs.
 if [ "$TOPOLOGY" = "dsa" ]; then
   echo "topology dsa: $TRUNK is the DSA conduit (tagger $(cat /sys/class/net/$TRUNK/dsa/tagging 2>/dev/null))"
-else
-  poll_until 15 eth_promisc || echo "WARN: $TRUNK not promiscuous after 15s, arming anyway"
+elif [ "$ARM" = 1 ]; then
+  poll_until 15 eth_promisc || arm_timeout "$TRUNK not promiscuous after 15s"
 fi
 
 sleep 3
 
-if [ "$(cat $FWM 2>/dev/null)" = "0x0" ]; then
+if [ "$ARM" = 1 ] && [ "$(cat $FWM 2>/dev/null)" = "0x0" ]; then
   MASK="$(uci -q get nss.general.fw_mask)" || MASK=''
-  if [ -z "$MASK" ] && [ "$TOPOLOGY" = "dsa" ]; then
+  if [ "$EW30SX" = 1 ]; then
+    MASK=0x1
+  elif [ -z "$MASK" ] && [ "$TOPOLOGY" = "dsa" ]; then
     # C-3PO: netifd has run, so a GMAC that is up is one that is in use -
     # the conduit and any WAN PHY of its own get armed, an unused GMAC or
     # a second CPU port DSA does not use stay on the host.
@@ -75,7 +95,10 @@ if [ "$(cat $FWM 2>/dev/null)" = "0x0" ]; then
     echo "topology dsa: fw_mask $MASK from the board (conduit ${NSS_CONDUIT:-none} = phys_if ${NSS_CONDUIT_IF:--}, GMACs $(nss_gmac_netdevs | tr '\n' ' '))"
   fi
   [ -n "$MASK" ] || MASK=0x2
-  echo "$MASK" > $FWM 2>/dev/null
+  if ! (echo "$MASK" > $FWM) 2>/dev/null; then
+    [ "$EW30SX" = 1 ] || exit 1
+    ARM=0
+  fi
 fi
 
 # Wi-Fi offload is loaded from here, not from the service, because ath11k
@@ -121,6 +144,7 @@ wifi_load_now() {
   local offload="$1"
 
   [ "$WIFI_OFFLOAD" = "1" ] || return 0        # the service already loaded it
+  [ "$EW30SX" = 0 ] || [ -e /tmp/ew30sx-wifi-ready ] || return 0
   grep -q '^ath11k_ahb ' /proc/modules && return 0  # someone got there first
   # NB: the guard is on ath11k_ahb, not ath11k - the core module may be in
   # already (a service restart, or a build without this package); it is the
@@ -257,12 +281,12 @@ wifi_sync_netifd() {
 }
 
 fw_started() { grep -q started $GLUE_STATUS 2>/dev/null; }
-poll_until 15 fw_started || {
+if [ "$ARM" = 0 ] || ! poll_until 15 fw_started; then
   echo "firmware takeover failed - staying on the host data path (same topology)"
   wifi_load_now 0
   wifi_sync_netifd
   exit 1
-}
+fi
 
 # The core is up: now ath11k can register wifili and get INITIALIZED.
 wifi_load_now 1
