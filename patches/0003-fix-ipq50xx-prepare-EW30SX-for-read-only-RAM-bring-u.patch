diff --git a/target/linux/qualcommax/files/drivers/mtd/spi-nor/w25q256jw-ro.c b/target/linux/qualcommax/files/drivers/mtd/spi-nor/w25q256jw-ro.c
new file mode 100644
index 0000000000..d60be26977
--- /dev/null
+++ b/target/linux/qualcommax/files/drivers/mtd/spi-nor/w25q256jw-ro.c
@@ -0,0 +1,110 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Read-only access to the EW30SX factory data for RAM-only bring-up.
+ * Use dedicated 4-byte reads in either address mode; never write a
+ * register, change the address mode, program or erase the flash.
+ */
+
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/mtd/mtd.h>
+#include <linux/mtd/partitions.h>
+#include <linux/of.h>
+#include <linux/sizes.h>
+#include <linux/spi/spi.h>
+#include <linux/unaligned.h>
+
+static int ew30sx_nor_read(struct mtd_info *mtd, loff_t from, size_t len,
+			   size_t *retlen, u_char *buf)
+{
+	struct spi_device *spi = mtd->priv;
+	u8 cmd[5] = { 0x13 };
+	size_t max_size;
+	int ret;
+
+	if (spi_max_message_size(spi) <= sizeof(cmd) ||
+	    spi_max_transfer_size(spi) < sizeof(cmd))
+		return -EOPNOTSUPP;
+
+	max_size = min3((size_t)SZ_4K, spi_max_transfer_size(spi),
+			spi_max_message_size(spi) - sizeof(cmd));
+	*retlen = 0;
+	while (len) {
+		size_t count = min(len, max_size);
+
+		put_unaligned_be32(from, cmd + 1);
+		ret = spi_write_then_read(spi, cmd, sizeof(cmd), buf, count);
+		if (ret)
+			return ret;
+
+		from += count;
+		buf += count;
+		len -= count;
+		*retlen += count;
+	}
+
+	return 0;
+}
+
+static int ew30sx_nor_probe(struct spi_device *spi)
+{
+	static const char * const parsers[] = { "ofpart", NULL };
+	struct mtd_info *mtd;
+	u8 cmd = 0x9f;
+	u8 id[3];
+	int ret;
+
+	ret = spi_write_then_read(spi, &cmd, 1, id, sizeof(id));
+	if (ret)
+		return ret;
+
+	/* W25Q256JW and its industrial/industrial-plus variant. */
+	if (id[0] != 0xef || (id[1] != 0x60 && id[1] != 0x80) || id[2] != 0x19)
+		return dev_err_probe(&spi->dev, -ENODEV,
+				     "expected W25Q256JW, got JEDEC %*phN\n",
+				     (int)sizeof(id), id);
+
+	mtd = devm_kzalloc(&spi->dev, sizeof(*mtd), GFP_KERNEL);
+	if (!mtd)
+		return -ENOMEM;
+
+	mtd->name = dev_name(&spi->dev);
+	mtd->dev.parent = &spi->dev;
+	mtd->owner = THIS_MODULE;
+	mtd->type = MTD_NORFLASH;
+	mtd->flags = MTD_CAP_ROM | MTD_NO_ERASE;
+	mtd->size = SZ_32M;
+	mtd->erasesize = SZ_64K;
+	mtd->writesize = 1;
+	mtd->writebufsize = 1;
+	mtd->priv = spi;
+	mtd->_read = ew30sx_nor_read;
+	mtd_set_of_node(mtd, spi->dev.of_node);
+	spi_set_drvdata(spi, mtd);
+
+	return mtd_device_parse_register(mtd, parsers, NULL, NULL, 0);
+}
+
+static void ew30sx_nor_remove(struct spi_device *spi)
+{
+	mtd_device_unregister(spi_get_drvdata(spi));
+}
+
+static const struct of_device_id ew30sx_nor_of_match[] = {
+	{ .compatible = "vnpt,ew30sx-calibration-nor" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, ew30sx_nor_of_match);
+
+static struct spi_driver ew30sx_nor_driver = {
+	.driver = {
+		.name = "ew30sx-calibration-nor",
+		.of_match_table = ew30sx_nor_of_match,
+	},
+	.probe = ew30sx_nor_probe,
+	.remove = ew30sx_nor_remove,
+};
+module_spi_driver(ew30sx_nor_driver);
+
+MODULE_DESCRIPTION("Read-only W25Q256JW access for EW30SX RAM boot");
+MODULE_LICENSE("GPL");
