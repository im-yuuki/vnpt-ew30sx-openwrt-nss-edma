diff --git a/target/linux/qualcommax/ipq50xx/base-files/lib/functions/ew30sx-wifi.sh b/target/linux/qualcommax/ipq50xx/base-files/lib/functions/ew30sx-wifi.sh
new file mode 100644
index 0000000000..aa2aae1628
--- /dev/null
+++ b/target/linux/qualcommax/ipq50xx/base-files/lib/functions/ew30sx-wifi.sh
@@ -0,0 +1,58 @@
+# SPDX-License-Identifier: GPL-2.0-only
+
+# Check the fixed map and the kernel's MTD_WRITEABLE bit, not just the label.
+ew30sx_mtd() {
+	local id dev flags
+
+	id="$(find_mtd_index "$1")"
+	case "$id" in ''|*[!0-9]*) return 1 ;; esac
+	dev="/sys/class/mtd/mtd$id"
+	[ "$(cat "$dev/offset")" = "$2" ] || return 1
+	[ "$(cat "$dev/size")" = "$3" ] || return 1
+	flags="$(cat "$dev/flags")" || return 1
+	[ $((flags & 0x400)) -eq 0 ] || return 1
+	echo "$id"
+}
+
+ew30sx_check_blob() {
+	[ "$(wc -c < "$1")" = 131072 ] &&
+		[ "$(tr -d '\000\377' < "$1" | wc -c)" -gt 0 ]
+}
+
+# The stock MP02 script reads raw 128 KiB slices from ART. Stock's BDFs
+# are separate files in the WIFIFW SquashFS. Do not keep a copy of ART,
+# use stock executable firmware, or patch the factory bytes.
+ew30sx_stage_wifi() (
+	local art wififw dir fw
+
+	[ -e /tmp/ew30sx-wifi-ready ] && return 0
+	art="$(ew30sx_mtd 0:ART 1769472 458752)" || return 1
+	wififw="$(ew30sx_mtd 0:WIFIFW 28442624 4194304)" || return 1
+	[ -c "/dev/mtd${art}ro" ] && [ -b "/dev/mtdblock$wififw" ] || return 1
+
+	umask 077
+	dir="$(mktemp -d /tmp/ew30sx-wifi.XXXXXX)" || return 1
+	mkdir "$dir/stock" || { rmdir "$dir"; return 1; }
+	trap 'umount "$dir/stock" 2>/dev/null
+		rm -f "$dir/bdf-2g" "$dir/bdf-5g" "$dir/cal-2g" "$dir/cal-5g"
+		rmdir "$dir/stock" "$dir" 2>/dev/null' EXIT
+	mount -t squashfs -o ro,nodev,nosuid,noexec "/dev/mtdblock$wififw" "$dir/stock" ||
+		return 1
+
+	cp "$dir/stock/bdwlan.b10" "$dir/bdf-2g" &&
+		cp "$dir/stock/qcn6122/bdwlan.b90" "$dir/bdf-5g" &&
+		dd if="/dev/mtd${art}ro" of="$dir/cal-2g" bs=2048 skip=2 count=64 2>/dev/null &&
+		dd if="/dev/mtd${art}ro" of="$dir/cal-5g" bs=2048 skip=77 count=64 2>/dev/null ||
+		return 1
+	umount "$dir/stock" || return 1
+	for fw in bdf-2g bdf-5g cal-2g cal-5g; do
+		ew30sx_check_blob "$dir/$fw" || return 1
+	done
+
+	fw=/lib/firmware/ath11k
+	cp "$dir/bdf-2g" "$fw/IPQ5018/hw1.0/board.bin" &&
+		cp "$dir/bdf-5g" "$fw/QCN6122/hw1.0/board.bin" &&
+		cp "$dir/cal-2g" "$fw/IPQ5018/hw1.0/cal-ahb-c000000.wifi.bin" &&
+		cp "$dir/cal-5g" "$fw/QCN6122/hw1.0/cal-ahb-b00a040.wifi.bin" &&
+		touch /tmp/ew30sx-wifi-ready
+)
