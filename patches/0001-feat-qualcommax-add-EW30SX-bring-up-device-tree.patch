From 6eb9ba1b68d62c794d7ac6012d9b17e0a428ed61 Mon Sep 17 00:00:00 2001
From: Yuuki <me@june8th.eu.org>
Date: Sat, 21 Nov 2026 01:41:55 +0700
Subject: [PATCH 1/7] feat(qualcommax): add EW30SX bring-up device tree

---
 .../qualcommax/dts/ipq5018-vnpt-ew30sx.dts    | 337 ++++++++++++++++++
 1 file changed, 337 insertions(+)
 create mode 100644 target/linux/qualcommax/dts/ipq5018-vnpt-ew30sx.dts

diff --git a/target/linux/qualcommax/dts/ipq5018-vnpt-ew30sx.dts b/target/linux/qualcommax/dts/ipq5018-vnpt-ew30sx.dts
new file mode 100644
index 0000000000..e5955d786f
--- /dev/null
+++ b/target/linux/qualcommax/dts/ipq5018-vnpt-ew30sx.dts
@@ -0,0 +1,337 @@
+// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
+
+/dts-v1/;
+
+#include "ipq5018.dtsi"
+#include "ipq5018-ess.dtsi"
+#include "ipq5018-qcn6122.dtsi"
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/leds/common.h>
+
+/ {
+	model = "VNPT iGate EW30SX";
+	compatible = "vnpt,ew30sx", "qcom,ipq5018";
+
+	aliases {
+		serial0 = &blsp1_uart1;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+
+	memory@40000000 {
+		reg = <0x0 0x40000000 0x0 0x10000000>;
+	};
+
+	reserved-memory {
+		/*
+		 * Retain the full stock WCSS carveout. The QCN6122 include
+		 * already covers its first 34 MiB; keep the rest out of RAM
+		 * without assuming the second PD's firmware layout.
+		 */
+		wcss-reserved@4d200000 {
+			reg = <0x0 0x4d200000 0x0 0x1200000>;
+			no-map;
+		};
+	};
+
+	keys {
+		compatible = "gpio-keys";
+		pinctrl-0 = <&button_pins>;
+		pinctrl-names = "default";
+
+		button-reset {
+			label = "reset";
+			gpios = <&tlmm 17 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_RESTART>;
+		};
+
+		button-wps {
+			label = "wps";
+			gpios = <&tlmm 34 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_WPS_BUTTON>;
+			debounce-interval = <60>;
+		};
+	};
+
+	leds {
+		compatible = "gpio-leds";
+		pinctrl-0 = <&led_pins>;
+		pinctrl-names = "default";
+
+		led-wan-red {
+			gpios = <&tlmm 4 GPIO_ACTIVE_LOW>;
+			color = <LED_COLOR_ID_RED>;
+			function = LED_FUNCTION_WAN;
+		};
+
+		led-wan-green {
+			gpios = <&tlmm 30 GPIO_ACTIVE_LOW>;
+			color = <LED_COLOR_ID_GREEN>;
+			function = LED_FUNCTION_WAN;
+		};
+
+		led-system-red {
+			gpios = <&tlmm 5 GPIO_ACTIVE_LOW>;
+			color = <LED_COLOR_ID_RED>;
+			function = LED_FUNCTION_STATUS;
+		};
+
+		led-system-green {
+			gpios = <&tlmm 6 GPIO_ACTIVE_LOW>;
+			color = <LED_COLOR_ID_GREEN>;
+			function = LED_FUNCTION_STATUS;
+		};
+
+		led-wifi {
+			gpios = <&tlmm 35 GPIO_ACTIVE_LOW>;
+			function = LED_FUNCTION_WLAN;
+		};
+	};
+};
+
+&sleep_clk {
+	clock-frequency = <32000>;
+};
+
+&xo_board_clk {
+	clock-div = <4>;
+	clock-mult = <1>;
+};
+
+/* Keep the fork's NSS and TZ-apps reservations as well as stock TZ. */
+&tz_region {
+	reg = <0x0 0x4ac00000 0x0 0x400000>;
+};
+
+&blsp1_uart1 {
+	pinctrl-0 = <&serial_0_pins>;
+	pinctrl-names = "default";
+	status = "okay";
+};
+
+/* Keep NOR inactive until the JEDEC geometry has been verified. */
+&blsp1_spi1 {
+	pinctrl-0 = <&spi_0_pins>;
+	pinctrl-names = "default";
+	status = "disabled";
+
+	flash@0 {
+		compatible = "jedec,spi-nor";
+		reg = <0>;
+		spi-max-frequency = <50000000>;
+
+		partitions {
+			compatible = "fixed-partitions";
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			partition@0 {
+				label = "0:SBL1";
+				reg = <0x0 0x30000>;
+				read-only;
+			};
+
+			partition@30000 {
+				label = "0:MIBIB";
+				reg = <0x30000 0x10000>;
+				read-only;
+			};
+
+			partition@40000 {
+				label = "0:QSEE";
+				reg = <0x40000 0xa0000>;
+				read-only;
+			};
+
+			partition@e0000 {
+				label = "0:DEVCFG";
+				reg = <0xe0000 0x10000>;
+				read-only;
+			};
+
+			partition@f0000 {
+				label = "0:CDT";
+				reg = <0xf0000 0x10000>;
+				read-only;
+			};
+
+			partition@100000 {
+				label = "0:APPSBLENV";
+				reg = <0x100000 0x10000>;
+				read-only;
+			};
+
+			partition@110000 {
+				label = "0:APPSBL";
+				reg = <0x110000 0xa0000>;
+				read-only;
+			};
+
+			partition@1b0000 {
+				label = "0:ART";
+				reg = <0x1b0000 0x70000>;
+				read-only;
+			};
+
+			partition@220000 {
+				label = "0:HLOS";
+				reg = <0x220000 0x500000>;
+				read-only;
+			};
+
+			partition@720000 {
+				label = "rootfs";
+				reg = <0x720000 0x1400000>;
+				read-only;
+			};
+
+			partition@1b20000 {
+				label = "0:WIFIFW";
+				reg = <0x1b20000 0x400000>;
+				read-only;
+			};
+
+			partition@1f20000 {
+				label = "0:BTFW";
+				reg = <0x1f20000 0x40000>;
+				read-only;
+			};
+		};
+	};
+};
+
+&prng {
+	status = "okay";
+};
+
+/* Provide the calibration cells used by the SoC thermal sensor. */
+&qfprom {
+	status = "okay";
+};
+
+/* GMAC0's built-in PHY is confirmed; do not assign a jack label yet. */
+&gmac0 {
+	status = "okay";
+};
+
+&gmac1 {
+	phy-mode = "sgmii";
+	status = "disabled";
+
+	fixed-link {
+		speed = <1000>;
+		full-duplex;
+	};
+};
+
+&mdio0 {
+	status = "okay";
+};
+
+/* Probe PHY IDs without driving the unverified board reset line. */
+&mdio1 {
+	pinctrl-0 = <&mdio1_pins>;
+	pinctrl-names = "default";
+	status = "okay";
+
+	ethernet-phy@0 {
+		reg = <0>;
+	};
+
+	ethernet-phy@1 {
+		reg = <1>;
+	};
+
+	ethernet-phy@2 {
+		reg = <2>;
+	};
+
+	ethernet-phy@3 {
+		reg = <3>;
+	};
+
+	/*
+	 * Use the usual qca8k management address and the stock DT's CPU6
+	 * candidate. Keep the fabric disabled until both are validated.
+	 */
+	ethernet-switch@11 {
+		compatible = "qca,qca8337";
+		reg = <0x11>;
+		status = "disabled";
+
+		ethernet-ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			ethernet-port@6 {
+				reg = <6>;
+				ethernet = <&gmac1>;
+				phy-mode = "sgmii";
+
+				fixed-link {
+					speed = <1000>;
+					full-duplex;
+				};
+			};
+		};
+	};
+};
+
+&tlmm {
+	button_pins: button-state {
+		pins = "gpio17", "gpio34";
+		function = "gpio";
+		drive-strength = <8>;
+		bias-pull-up;
+	};
+
+	led_pins: led-state {
+		pins = "gpio4", "gpio5", "gpio6", "gpio30", "gpio35";
+		function = "gpio";
+		drive-strength = <8>;
+		bias-pull-down;
+	};
+
+	mdio1_pins: mdio-state {
+		mdc-pins {
+			pins = "gpio36";
+			function = "mdc";
+			drive-strength = <8>;
+			bias-pull-up;
+		};
+
+		mdio-pins {
+			pins = "gpio37";
+			function = "mdio";
+			drive-strength = <8>;
+			bias-pull-up;
+		};
+	};
+
+	serial_0_pins: uart0-state {
+		pins = "gpio28", "gpio29";
+		function = "blsp0_uart1";
+		drive-strength = <8>;
+		bias-disable;
+	};
+
+	spi_0_pins: spi0-state {
+		pins = "gpio10", "gpio11", "gpio12", "gpio13";
+		function = "blsp0_spi";
+		drive-strength = <2>;
+		bias-disable;
+	};
+};
+
+/* Both radios remain disabled until WCSS, BDF and per-unit data are known. */
+&q6v5_wcss {
+	status = "disabled";
+};
+
+&wcss {
+	status = "disabled";
+};
